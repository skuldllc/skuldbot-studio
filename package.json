{
  "name": "skuldbot-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "gen:availability": "bash ./scripts/gen_node_availability.sh",
    "gen:catalog-contract": "node ./scripts/gen_catalog_contract.mjs",
    "smoke:compile:nodes": "bash ./scripts/smoke_compile_all_nodes.sh",
    "migrate:legacy-expr": "python3 ./scripts/migrate_legacy_expressions.py",
    "test:planner-flow": "node ./scripts/run_planner_flow_tests.mjs",
    "test:node-availability": "node ./scripts/run_node_availability_tests.mjs",
    "test:catalog-contract": "node ./scripts/check_catalog_contract.mjs",
    "test:flow-runtime": "node ./scripts/run_flow_runtime_requirements_tests.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "kill-vite": "lsof -ti:1420 | xargs kill -9 2>/dev/null || true",
    "verify": "bash ./scripts/verify_studio.sh",
    "verify:ui": "npm run lint && npm run build && npm run test:catalog-contract && npm run test:node-availability && npm run test:flow-runtime"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.309.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.10.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "terser": "^5.46.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vite-plugin-obfuscator": "^1.0.5"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<7.29.6": "7.29.6",
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "esbuild@<0.25.0": "0.25.0",
      "flatted@<3.4.2": "3.4.2",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "rollup@<4.59.0": "4.59.0"
    }
  }
}
